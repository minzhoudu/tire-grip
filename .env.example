# Local: docker-compose Postgres. On Vercel + Neon, use Neon's *pooled* connection
# string (the one with "-pooler" in the hostname) — serverless functions open many
# short-lived connections, and only the pooler absorbs that without exhausting Postgres.
DATABASE_URL=postgres://tiregrip:tiregrip@localhost:5432/tiregrip

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public URL used in links sent to customers (defaults to BETTER_AUTH_URL)
# APP_URL=https://app.example.rs

# Emails allowed into /platforma (the platform owner's dashboard), comma-separated
PLATFORM_ADMIN_EMAILS=
