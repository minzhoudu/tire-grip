# Local: docker-compose Postgres. On Vercel + Neon, use Neon's *pooled* connection
# string (the one with "-pooler" in the hostname) — serverless functions open many
# short-lived connections, and only the pooler absorbs that without exhausting Postgres.
DATABASE_URL=postgres://tiregrip:tiregrip@localhost:5432/tiregrip

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public URL used in links sent to customers (defaults to BETTER_AUTH_URL)
# APP_URL=https://app.example.rs

# Emails allowed into /platforma (the platform owner's dashboard), comma-separated
PLATFORM_ADMIN_EMAILS=

# Email (Resend). Without a key, emails are printed to the server log instead.
# RESEND_API_KEY=
# EMAIL_FROM="Moj Vulkanizer <obavestenja@mojvulkanizer.com>"

# Push notifications to shop members' phones (Web Push / VAPID).
# Generate once: pnpm dlx web-push generate-vapid-keys — and never change them,
# or every device has to turn notifications on again. Without them, push is off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach you at (mailto: or https:)
# VAPID_SUBJECT=mailto:podrska@mojvulkanizer.com
